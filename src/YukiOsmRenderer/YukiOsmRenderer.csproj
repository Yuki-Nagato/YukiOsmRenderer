<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>yukiosm</AssemblyName>
    <RootNamespace>YukiOsmRenderer</RootNamespace>
    <!-- Avoid depending on a system ICU on Linux; Mapnik brings its own Unicode handling. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YukiOsmRenderer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YukiOsmRenderer.Core\YukiOsmRenderer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

</Project>