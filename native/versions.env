# GDAL's ogr2ogr, with which OpenStreetMap Carto's get-external-data.py loads the external data (vcpkg port "gdal"
# with only the PostgreSQL driver and the tools, pinned by the vcpkg commit; must match native/gdal/vcpkg.json)
GDAL_VERSION=3.12.4

