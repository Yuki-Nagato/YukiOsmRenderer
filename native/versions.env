# Pinned versions and download locations of the bundled native components.
# Read by build-windows.ps1 and linux/build.sh. Format: KEY=value (no quotes, no spaces, no expansion).

# PostgreSQL 17 (Windows: EDB binary archive "17.11-5", file id 1260616; Linux: source)
POSTGRESQL_VERSION=17.11
