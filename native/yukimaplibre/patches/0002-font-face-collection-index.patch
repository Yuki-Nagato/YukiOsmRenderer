 #include <mln/util/image.hpp>
 #include <mln/util/logging.hpp>
 
+#include <cstdlib>
 #include <fstream>
+#include <map>
+#include <mutex>
+#include <string>
 
 namespace mln {
 
 namespace {
 GlyphManagerObserver nullObserver;
+
+// A font face URL may end in "#n" to select face n of a font collection (.ttc).
+std::string fontFaceFile(const std::string& url) {
+    return url.substr(0, url.rfind('#'));
+}
+
+long fontFaceIndex(const std::string& url) {
+    const auto hash = url.rfind('#');
+    return hash == std::string::npos ? 0 : std::strtol(url.c_str() + hash + 1, nullptr, 10);
+}
+
+// Font files are large; maps loading the same file share one copy for as long as any of them uses it.
+std::shared_ptr<const std::string> shareFontData(const std::string& file, std::shared_ptr<const std::string> data) {
+    static std::mutex mutex;
+    static std::map<std::string, std::weak_ptr<const std::string>> shared;
+    if (!data) {
+        return data;
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    auto& entry = shared[file];
+    if (auto existing = entry.lock(); existing && *existing == *data) {
+        return existing;
+    }
+    entry = data;
+    return data;
 }
+} // namespace
 
