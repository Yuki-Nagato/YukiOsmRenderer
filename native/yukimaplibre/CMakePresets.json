{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../artifacts/cache/build/${presetName}/yukimaplibre",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/../../artifacts/cache/build/${presetName}/vcpkg_installed_maplibre",
        "YUKIMAPLIBRE_MLN_SOURCE_DIR": "$env{YUKIMAPLIBRE_MLN_SOURCE_DIR}",
        "YUKIMAPLIBRE_MLN_VERSION": "$env{YUKIMAPLIBRE_MLN_VERSION}"
      }
    },
    {
      "name": "win-x64",
      "displayName": "Windows x64 (static, static CRT)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (static dependencies)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release",
        "VCPKG_HOST_TRIPLET": "x64-linux-release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux arm64 (static dependencies)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-release",
        "VCPKG_HOST_TRIPLET": "arm64-linux-release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64",
      "configurePreset": "win-x64"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    }
  ]
}
