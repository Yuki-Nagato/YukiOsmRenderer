{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "yukiosm",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/YukiOsmRenderer/bin/Debug/net10.0/yukiosm.dll",
