root = true

[*.cs]
end_of_line = lf
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

[*.{c,cc,cpp,h,hpp,sh,ps1,psm1,cmake,html,css,js,md}]
end_of_line = lf
indent_style = space
indent_size = 4

[{CMakeLists.txt,Dockerfile,*.Dockerfile}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
end_of_line = lf
indent_style = space
indent_size = 2
